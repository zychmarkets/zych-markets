# Copy to /etc/zych-markets/zych.env, set production values, then chmod 600.
ZYCH_HOST=127.0.0.1
ZYCH_PORT=4178
ZYCH_DATA_DIR=/var/lib/zych-markets
ZYCH_HISTORY_LIMIT=500
ZYCH_LOG_LEVEL=info
ZYCH_SHUTDOWN_TIMEOUT_MS=15000
ZYCH_ALLOWED_ORIGINS=https://app.zych.markets
RADAR_INTERNAL_DIAGNOSTICS_ENABLED=false

RADAR_UNIVERSE_ENABLED=true
RADAR_INGESTION_ENABLED=true
RADAR_TARGET_SIZE=100
RADAR_TIMEFRAMES=1m,5m,15m
RADAR_READINESS_MIN_COMPLETE_RATIO=0.1
RADAR_READINESS_MAX_HEALTHY_AGE_MS=180000

# Optional Web Push. Leave both keys empty to disable it safely.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.invalid
